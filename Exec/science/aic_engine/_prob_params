# name			data type			default		namelist param?			size

## INPUT MODEL PARAMETERS ##

model_file  string  ""  y

# Ambient medium density (should be >= ambient medium density in the model file)
rho_amb  real  1e-20  y

# Ambient medium temperature (should be >= ambient medium temperature in the model file)
T_amb  real  275  y

# 0 => do not fill underdense regions near vertical axis; 1 => use min density in ejecta;
# 2 => use average density in ejecta
fill_underdense  int  1  y

## MAGNETAR PARAMETERS ##

# Magnetar turn-on time (in s)
t_mag_act    real    100.0    y

# Size of the deposition region
r_dep    real    2e9    y

# Scale of deposition region in units of f_dep * r_0
depscale real    2.0     y

# Power for power law deposition rate dropoff
p_dep    real    8.380235398212328     y

# Scalar multiplier for deposition rate
frac_lum_base    real    1.0   y

# Standard deviation for equatorial profile in radians (ignored for non-equatorial deposition)
eq_ang    real    0.08726646259971647    y 

# Initial magnetar period (in ms)
P_0    real    1.0    y

# Magnetar radius (in units of 10^6 cm; used in energy/luminosity calculations)
R_mag    real    1.0   y

# Sine of the inclination angle between the magnetic and rotational axes
sin_alph    real    0.5    y

# Magnetic field (in units of 10^{15} G)
B_mag    real    1.0    y

# Magnetar moment of inertia (in units of 10^45 g cm^2)
I_mag    real    1.0   y

# Index for energy injection decay (L \propto (t/t_eng + 1)^{-k_eng})
k_eng    real    2.0   y

# Mass injection rate multiplier
mass_mult real 1.0  y

## OTHER PARAMETERS ##

### AMR stuff ##

# Number of additional refinement levels for the ejecta
ejecta_tagging_level    integer   1   y

# Number of additional refinement levels for intermediate layer
buffer_tagging_level    integer   2   y

# Number of additional refinement levels for the bubble
bubble_tagging_level    integer   3   y

# Refine scale for the intermediate AMR level
refine_scale_buf   real    1.2    y

# The radius (in units of r_dep*depscale) to refine further within at initialization
refine_scale_bub   real    2.0    y
